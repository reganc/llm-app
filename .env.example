# ── Local LLM Stack — Environment Variables ────────────────────────────
# Copy to `.env` and fill in real values. UI lives at http://localhost:8030

# API security — CHANGE THIS before exposing to any network.
# Generate one with: openssl rand -base64 32
API_KEY=change-me-in-production

# Model selection (must be available on Ollama; api will pull on startup)
DEFAULT_MODEL=mistral:7b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text

# Limits
MAX_TOKENS=4096
CORS_ORIGINS=*

# SearXNG — generate with: openssl rand -hex 32
SEARXNG_SECRET_KEY=change-this-secret-key-please

# Optional: Firecrawl on host (leave default if not running)
FIRECRAWL_URL=http://host.docker.internal:3002
FIRECRAWL_API_KEY=fc-local

# Optional: X / Twitter search (requires creds at ~/.x-cli/credentials.json)
X_SEARCH_ENABLED=false

# Optional: comma-separated URLs always fetched on every web search
AUXILIARY_SITES=
