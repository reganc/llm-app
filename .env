# ── Local LLM Stack — Environment Variables ──────────────────
# Copy this to .env and customize. docker-compose.yml reads these.

# API Security — CHANGE THIS before exposing to any network
API_KEY=change-me-in-production

# Model selection
DEFAULT_MODEL=dolphin-mistral

# Ollama performance (RTX 3060 defaults)
OLLAMA_NUM_PARALLEL=2
OLLAMA_KEEP_ALIVE=24h
OLLAMA_FLASH_ATTENTION=1

# Web UI
WEBUI_AUTH=false
WEBUI_NAME=My Local AI

# API limits
MAX_TOKENS=4096
CORS_ORIGINS=*
